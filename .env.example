# ╔══════════════════════════════════════════════════════════════════╗
# ║                    EduCore Configuration                        ║
# ╚══════════════════════════════════════════════════════════════════╝

# === Database (PostgreSQL + pgvector) ===
DATABASE_URL=postgresql+asyncpg://educore:educore_pass@localhost:5432/educore
DATABASE_URL_SYNC=postgresql://educore:educore_pass@localhost:5432/educore

# === OpenRouter API ===
OPENROUTER_API_KEY=REPLACE_ME
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODEL=baidu/ernie-5.5-flash-preview:free
OPENROUTER_VISION_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_MAX_TOKENS=60000
OPENROUTER_TEMPERATURE=0.3
# Web search uses a separately billed service. Set true only if enabled on your account.
OPENROUTER_ENABLE_WEB_SEARCH=false

# === Embedding Model (sentence-transformers, local) ===
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# === RAG Pipeline ===
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MIN_CHUNK_CHARS=100
OCR_LANGUAGES=eng+ara
OCR_DPI=250
# Optional: full path to tesseract.exe and its tessdata folder.
TESSERACT_CMD=
TESSDATA_DIR=./storage/tessdata
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.3

# === Celery (Background Processing) ===
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# === Chat ===
CHAT_HISTORY_LIMIT=10

# === File Storage ===
STORAGE_DIR=./storage

# === FastAPI ===
API_HOST=0.0.0.0
API_PORT=8000
